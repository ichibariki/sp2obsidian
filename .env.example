# sp2obsidian の設定ファイルの見本です。
# このファイルを .env という名前でコピーして、値を書き込んでください（.env は Git に入りません）。
# Copy this file to .env and fill in the values. Never commit .env.

# 自分で作った Spotify Developer アプリの Client ID（必須。docs/setup.md 参照）
# Client ID of YOUR OWN Spotify Developer app (required)
SPOTIFY_CLIENT_ID=

# Dashboard に登録した Redirect URI と同じ値（省略時は下の値）。localhost は使えません
# Must match the Redirect URI registered in the Dashboard (localhost is not allowed)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Obsidian の Vault のフォルダ（絶対パス。--vault でも指定可）
# Absolute path to your Obsidian vault (or use --vault)
SP2OBSIDIAN_VAULT=

# Vault の中でアーティストノートを置くフォルダ（Vault からの相対パス。既定: Artists）
# Folder for artist notes, relative to the vault (default: Artists)
SP2OBSIDIAN_ARTISTS_DIR=Artists
